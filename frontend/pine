// Generated by ProRealAlgos.com
// === TIMEFRAME ===
// Run system on 5-minute chart
// Uses multi-timeframe: Daily + 15m + 5m
DEFPARAM CumulateOrders = False
// === STEP 1: DAILY RANGE (YESTERDAY) ===
prevHigh = DHigh(1)
prevLow  = DLow(1)
// === SESSION FILTER (FIRST 150 MINUTES) ===
// Adjust depending on market (example: US open 15:30 -> 153000)
sessionStart = 153000
sessionEnd   = 180000   // +150 min
validTime = Time >= sessionStart AND Time <= sessionEnd
// === STEP 2: 15M BREAKOUT DETECTION ===
TIMEFRAME(15 minutes)
breakoutUp   = Close > prevHigh
breakoutDown = Close < prevLow
TIMEFRAME(DEFAULT)
// Store breakout state
IF breakoutUp THEN
dir = 1
ENDIF
IF breakoutDown THEN
dir = -1
ENDIF
// === STEP 3: 5M RETEST + CANDLE PATTERNS ===
// --- Candle calculations --
body      
= ABS(Close - Open)
ranged     = High - Low
upperWick = High - MAX(Open, Close)
lowerWick = MIN(Open, Close) - Low
// --- Hammer (bullish) --
hammer = lowerWick > body * 2 AND upperWick < body
// --- Inverted hammer (bearish) --
invHammer = upperWick > body * 2 AND lowerWick < body
// --- Engulfing --
bullEngulf = Close > Open AND Close > High[1] AND Open < Low[1]
bearEngulf = Close < Open AND Close < Low[1] AND Open > High[1]
// --- Retest condition --
retestLong  = Low <= prevHigh AND Close > prevHigh
retestShort = High >= prevLow AND Close < prevLow
// === ENTRY LOGIC ===
IF NOT ONMARKET AND validTime THEN
// LONG SETUP
IF dir = 1 AND retestLong THEN
// Hammer entry (next candle break)
IF hammer THEN
BUY 1 CONTRACT AT MARKET
stopl = prevHigh - (ranged × 0.2)
risk = Close - stopl
SET STOP PRICE stopl
SET TARGET PRICE Close + (risk * 3)
ENDIF
// Bullish engulfing (early entry)
IF bullEngulf THEN
BUY 1 CONTRACT AT MARKET
stopl = prevHigh - (ranged × 0.2)
risk = Close - stopl
SET STOP PRICE stopl
SET TARGET PRICE Close + (risk * 3)
ENDIF
ENDIF
// SHORT SETUP
IF dir = -1 AND retestShort THEN
// Inverted hammer
IF invHammer THEN
SELLSHORT 1 CONTRACT AT MARKET
stopl = prevLow + (ranged × 0.2)
risk = stopl - Close
SET STOP PRICE stopl
SET TARGET PRICE Close - (risk * 3)
ENDIF
// Bearish engulfing
IF bearEngulf THEN
SELLSHORT 1 CONTRACT AT MARKET
stopl = prevLow + (ranged × 0.2)
risk = stopl - Close
SET STOP PRICE stopl
SET TARGET PRICE Close - (risk * 3)
ENDIF
ENDIF
ENDIF
// === EXIT AT END OF DAY ===
IF Time >= 220000 AND ONMARKET THEN
SELL AT MARKET
EXITSHORT AT MARKET
ENDIF